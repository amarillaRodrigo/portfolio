---
import { DEFAULT_LOCALE } from "../data/types";

/**
 * The site root redirects into the default locale.
 *
 * Every real URL carries its locale: /es/... and /en/... There is no
 * unprefixed page, so the root has to hand the visitor to one of them.
 */
export const prerender = true;
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <title>Rodrigo Amarilla — Backend Engineer</title>
    <meta
      name="description"
      content="Backend Engineer con foco en cloud engineering. APIs REST y microservicios en Java, Node y Python, desplegados en AWS con Kubernetes, Terraform y CI/CD."
    />
    <link rel="canonical" href={`https://rodrigoamarilla.tech/${DEFAULT_LOCALE}/`} />
    <meta http-equiv="refresh" content={`0; url=/${DEFAULT_LOCALE}/`} />
    <script is:inline>
      window.location.replace(`/${DEFAULT_LOCALE}/`);
    </script>
  </head>
  <body>
    <p><a href={`/${DEFAULT_LOCALE}/`}>Rodrigo Amarilla — Backend Engineer</a></p>
  </body>
</html>
