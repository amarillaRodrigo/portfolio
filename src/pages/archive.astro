---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
---
<BaseLayout title="Archive">
  <section class="fade-in">
    <h1 class="h1 mb-6">Archive</h1>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-left border-b border-white/10">
            <th class="py-2 pr-4">Año</th>
            <th class="py-2 pr-4">Proyecto</th>
            <th class="py-2 pr-4">Tags</th>
            <th class="py-2 pr-4">Link</th>
          </tr>
        </thead>
        <tbody>
          {projects.map((p) => (
            <tr class="border-b border-white/5 hover:bg-accent/5">
              <td class="py-2 pr-4 text-white/70">{p.year}</td>
              <td class="py-2 pr-4">{p.name}</td>
              <td class="py-2 pr-4 text-white/60">{p.tags.join(', ')}</td>
              <td class="py-2 pr-4">
                <a href={p.href} class="text-accent hover:underline">Ver →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
