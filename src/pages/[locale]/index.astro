---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import EmailCta from "../../components/EmailCta.astro";
import { featuredProjects, otherProjects } from "../../data/projects";
import { experiences } from "../../data/experiencia";
import { site, stack, stackGroups, mailtoHref, cvPath } from "../../data/site";
import { ui, t } from "../../data/ui";
import { LOCALES, DEFAULT_LOCALE, type Locale } from "../../data/types";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const locale = (Astro.props.locale ?? DEFAULT_LOCALE) as Locale;

const title =
  locale === "es"
    ? "Rodrigo Amarilla — Backend Engineer con foco en cloud"
    : "Rodrigo Amarilla — Backend Engineer with a cloud focus";

const description =
  locale === "es"
    ? "Backend Engineer. APIs REST y microservicios en Java, Node y Python, desplegados en AWS con Kubernetes, Terraform y CI/CD. Formosa, Argentina. Remoto LATAM y US-East."
    : "Backend Engineer. REST APIs and microservices in Java, Node and Python, deployed on AWS with Kubernetes, Terraform and CI/CD. Formosa, Argentina. Remote across LATAM and US-East.";

const experience = experiences[0];
---

<BaseLayout {title} {description} {locale} path="/">
  <!-- 1. HERO -->
  <section id="hero" class="hero">
    <div class="hero__headline">
      <h1 class="hero__name">{site.name}</h1>
      <p class="hero__role">{t(ui.hero.role, locale)}</p>
    </div>

    <p class="hero__stack">{stack.map((s) => s.value).join(" · ")}</p>

    <div class="hero__meta">
      <p class="hero__location">{site.location}</p>
      <p class="hero__remote">{t(ui.hero.remoteLine, locale)}</p>
      <p class="hero__availability">{t(ui.hero.availability, locale)}</p>
    </div>

    <div class="hero__actions">
      <EmailCta locale={locale} variant="primary" />
      <a class="cv-link" href={cvPath[locale]} download>
        {t(ui.hero.cv, locale)}
      </a>
    </div>
  </section>

  <!-- 2. EXPERIENCIA -->
  {
    experience && (
      <section id="experiencia" class="block">
        <h2 class="block__title">{t(ui.sections.experience, locale)}</h2>

        <article class="experience">
          <div class="experience__meta">
            <span class="experience__company">{experience.company}</span>
            <span class="experience__period">{experience.period}</span>
          </div>

          <h3 class="experience__title">{t(experience.title, locale)}</h3>
          <p class="experience__location">{t(experience.location, locale)}</p>
          <p class="experience__summary">{t(experience.summary, locale)}</p>

          <ul class="experience__highlights">
            {t(experience.highlights, locale).map((h) => (
              <li>{h}</li>
            ))}
          </ul>

          <ul class="tag-row">
            {experience.tech.map((tech) => (
              <li>{tech}</li>
            ))}
          </ul>
        </article>
      </section>
    )
  }

  <!-- 3. PROYECTOS DESTACADOS -->
  <section id="proyectos" class="block">
    <h2 class="block__title">{t(ui.sections.featured, locale)}</h2>

    <div class="rail">
      {
        featuredProjects.map((project) => (
          <ProjectCard project={project} locale={locale} />
        ))
      }
    </div>
  </section>

  <!-- 4. OTROS PROYECTOS -->
  <section id="otros" class="block">
    <h2 class="block__title">{t(ui.sections.others, locale)}</h2>

    <div class="others-grid">
      {
        otherProjects.map((project) => (
          <ProjectCard project={project} locale={locale} compact />
        ))
      }
    </div>
  </section>

  <!-- 5. STACK + CONTACTO -->
  <section id="stack" class="block">
    <h2 class="block__title">{t(ui.sections.stack, locale)}</h2>

    <div class="stack-grid">
      {
        stackGroups.map((group) => (
          <div class="stack-group">
            <h3 class="stack-group__label">{group.label}</h3>
            <ul class="tag-row">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section id="contacto" class="block">
    <h2 class="block__title">{t(ui.sections.contact, locale)}</h2>
    <p class="contact__intro">{t(ui.sections.contactIntro, locale)}</p>

    <div class="contact__actions">
      <a class="contact__email" href={mailtoHref(locale)}>{site.email}</a>
      <a class="cv-link" href={cvPath[locale]} download>
        {t(ui.hero.cv, locale)}
      </a>
    </div>

    <ul class="contact__links">
      <li>
        <a href={site.github} rel="noopener" target="_blank">GitHub</a>
      </li>
      <li>
        <a href={site.linkedin} rel="noopener" target="_blank">LinkedIn</a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: 3rem 0 4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero__name {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* The role is the positioning, not the action. The accent belongs to the
     CTA: one accented element per viewport is the whole budget. */
  .hero__role {
    margin: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hero__stack {
    margin: 0;
    max-width: 72ch;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    line-height: 1.7;
  }

  .hero__meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hero__location,
  .hero__remote,
  .hero__availability {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero__location {
    color: rgba(255, 255, 255, 0.9);
  }

  .hero__remote {
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__availability {
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .cv-link {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .cv-link:hover {
    color: #fafafa;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .cv-link:focus-visible {
    outline: 2px solid #fdff00;
    outline-offset: 2px;
  }

  /* BLOCKS */
  .block {
    padding: 4rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .block:last-of-type {
    border-bottom: none;
  }

  .block__title {
    margin: 0 0 2.5rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* EXPERIENCIA */
  .experience {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 78ch;
  }

  .experience__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .experience__company {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .experience__period {
    color: rgba(253, 255, 0, 0.8);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .experience__title {
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .experience__location {
    margin: 0;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .experience__summary {
    margin: 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
    line-height: 1.7;
  }

  .experience__highlights {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .experience__highlights li {
    position: relative;
    padding-left: 1.5rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    line-height: 1.7;
  }

  .experience__highlights li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: rgba(253, 255, 0, 0.8);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tag-row li {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
  }

  /* RAIL */
  .rail {
    display: flex;
    gap: 2rem;
    padding-bottom: 1rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
  }

  .rail > :global(a) {
    scroll-snap-align: start;
  }

  /* OTHERS */
  .others-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .others-grid :global(.project-card) {
    width: auto;
    min-height: auto;
  }

  /* STACK */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2.5rem;
  }

  .stack-group__label {
    margin: 0 0 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* CONTACT */
  .contact__intro {
    margin: 0 0 2rem;
    max-width: 60ch;
    color: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
    line-height: 1.7;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .contact__email {
    color: #fdff00;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: opacity 150ms ease;
  }

  .contact__email:hover {
    opacity: 0.8;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .contact__email:focus-visible {
    outline: 2px solid #fdff00;
    outline-offset: 2px;
  }

  .contact__links {
    display: flex;
    gap: 1.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .contact__links a {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .contact__links a:hover {
    color: #fafafa;
  }

  .contact__links a:focus-visible {
    outline: 2px solid #fdff00;
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2rem 0 3rem;
    }

    .block {
      padding: 3rem 0;
    }

    /* The name is set on one line at desktop width. On a phone it has to
       come down a size or it pushes the page into a horizontal scroll. */
    .hero__name {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
      letter-spacing: 0.03em;
    }

    .hero__location,
    .hero__remote,
    .hero__availability {
      white-space: normal;
    }
  }
</style>
